{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://52.67.241.122:8080/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://52.67.241.122:8080/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
